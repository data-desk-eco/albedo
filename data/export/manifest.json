{
  "name": "russian-arctic",

  "about": {
    "title": { "en": "About this map", "ru": "О карте" },
    "description": {
      "en": "Interactive map of vessel presence based on Global Fishing Watch data. Click anywhere to continue.",
      "ru": "Интерактивная карта присутствия судов на основе данных Global Fishing Watch. Нажмите в любом месте, чтобы продолжить."
    }
  },

  "map": {
    "center": [100, 75],
    "zoom": 2.5,
    "minZoom": 2.5,
    "maxZoom": 14,
    "pitch": 20,
    "projection": "globe",
    "bounds": {
      "south": 57,
      "north": 90,
      "west": 20,
      "east": -160
    }
  },

  "data": {
    "cog": "https://storage.googleapis.com/albedo-data/vessel_heatmap.tif",
    "vesselData": "https://storage.googleapis.com/albedo-data/vessel_data.bin",
    "cogsByType": {"FISHING":"https://storage.googleapis.com/albedo-data/vessel_heatmap_fishing.tif","CARGO":"https://storage.googleapis.com/albedo-data/vessel_heatmap_cargo.tif","PASSENGER":"https://storage.googleapis.com/albedo-data/vessel_heatmap_passenger.tif","CARRIER":"https://storage.googleapis.com/albedo-data/vessel_heatmap_carrier.tif"}
  },

  "layers": {
    "satellite": {
      "url": "https://tiles.maps.eox.at/wmts/1.0.0/s2cloudless-2021_3857/default/GoogleMapsCompatible/{z}/{y}/{x}.jpg",
      "defaultVisible": false
    },
    "vectors": {
      "protected-areas": {
        "url": "https://storage.googleapis.com/albedo-data/vectors.pmtiles",
        "defaultVisible": true,
        "style": [
          {
            "id": "protected-areas-fill",
            "type": "fill",
            "source-layer": "protected_areas",
            "paint": { "fill-pattern": "hatch-white-md", "fill-opacity": 1 }
          },
          {
            "id": "protected-areas-border",
            "type": "line",
            "source-layer": "protected_areas",
            "paint": { "line-color": "#ffffff", "line-width": 2, "line-opacity": 1 }
          }
        ]
      },
      "places": {
        "url": "https://storage.googleapis.com/albedo-data/vectors.pmtiles",
        "defaultVisible": true,
        "style": [
          {
            "id": "place-labels",
            "type": "symbol",
            "source-layer": "places",
            "minzoom": 2,
            "layout": {
              "text-field": ["coalesce", ["get", "name_ru"], ["get", "name_en"]],
              "text-font": ["Open Sans Regular", "Arial Unicode MS Regular"],
              "text-size": ["interpolate", ["linear"], ["zoom"], 2.5, 12, 10, 20],
              "text-anchor": "center",
              "text-padding": 2,
              "text-allow-overlap": false
            },
            "paint": {
              "text-color": "#666666",
              "text-halo-color": "#ffffff",
              "text-halo-width": 1.5
            }
          }
        ]
      }
    }
  },

  "ui": {
    "title": "Albedo",
    "favicon": "magenta",
    "defaultLang": "ru",
    "availableLangs": ["en", "ru"],
    "sourceLink": {
      "url": "https://globalfishingwatch.org/",
      "label": { "en": "Global Fishing Watch", "ru": "Global Fishing Watch" },
      "labelShort": { "en": "GFW", "ru": "GFW" }
    },
    "layerToggles": [
      {
        "layers": ["protected-areas-fill", "protected-areas-border"],
        "label": { "en": "Protected areas", "ru": "ООПТ" },
        "labelShort": { "en": "Protected", "ru": "ООПТ" },
        "symbol": "hatch",
        "defaultVisible": true
      },
      {
        "layers": ["satellite"],
        "label": { "en": "Satellite imagery", "ru": "Спутник" },
        "labelShort": { "en": "Satellite", "ru": "Спутник" },
        "symbol": "satellite",
        "defaultVisible": false,
        "isSatellite": true
      }
    ],
    "theme": {
      "background": "#000000",
      "text": "#ffffff",
      "textMuted": "rgba(255, 255, 255, 0.7)",
      "panelBg": "rgba(0, 0, 0, 0.6)",
      "panelBorder": "rgba(255, 255, 255, 0.2)",
      "panelHover": "rgba(255, 255, 255, 0.1)"
    }
  },

  "places": [{"id":"overview","name":{"en":"Overview","ru":"Обзор"},"description":{"en":"Full study area","ru":"Вся область исследования"},"center":[100,75],"zoom":2.5},{"id":"kara-sea","name":{"en":"Kara Sea","ru":"Карское море"},"description":{"en":"Gateway to the Northern Sea Route","ru":"Ворота Северного морского пути"},"center":[70,74],"zoom":5}]
}
