SOURCE_URL=https://globalfishingwatch.org/
SOURCE_LABEL="Global Fishing Watch"
SOURCE_LABEL_SHORT=GFW

#───────────────────────────────────────────────────────────────────────────────
# Region Configuration
#───────────────────────────────────────────────────────────────────────────────
REGION_ID=russian-arctic

# Bounding box (degrees)
SOUTH_LAT=57
NORTH_LAT=90
WEST_LON=20
EAST_LON=-160

# Initial map view
CENTER_LON=100
CENTER_LAT=75
INITIAL_ZOOM=2.5
MIN_ZOOM=2.5

# Years to include (comma-separated, max 3 for RGB bands)
YEARS=2023,2024,2025

# Vessel types for per-type COGs (comma-separated)
VESSEL_TYPES=FISHING,CARGO,PASSENGER,CARRIER

# Resolution
SPATIAL_RES=HIGH
TEMPORAL_RES=YEARLY

#───────────────────────────────────────────────────────────────────────────────
# UI Configuration
#───────────────────────────────────────────────────────────────────────────────
UI_TITLE=Albedo
UI_FAVICON=magenta
DEFAULT_LANG=ru
AVAILABLE_LANGS='["en", "ru"]'

# About text
ABOUT_EN="Interactive map of vessel presence based on Global Fishing Watch data. Click anywhere to continue."
ABOUT_RU="Интерактивная карта присутствия судов на основе данных Global Fishing Watch. Нажмите в любом месте, чтобы продолжить."

