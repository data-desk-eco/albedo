SOURCE_URL=https://globalfishingwatch.org/
SOURCE_LABEL="Global Fishing Watch"
SOURCE_LABEL_SHORT=GFW

#───────────────────────────────────────────────────────────────────────────────
# Region Configuration
#───────────────────────────────────────────────────────────────────────────────
REGION_ID=arctic

# Bounding box (degrees)
SOUTH_LAT=57
NORTH_LAT=90
WEST_LON=-180
EAST_LON=180

# Initial map view
CENTER_LON=100
CENTER_LAT=75
INITIAL_ZOOM=2.5
MIN_ZOOM=2.5

# Years to include (comma-separated, max 3 for RGB bands)
YEARS=2023,2024,2025

# Vessel types for per-type COGs (comma-separated)
VESSEL_TYPES=FISHING,CARGO,PASSENGER,CARRIER

# Resolution
SPATIAL_RES=HIGH
TEMPORAL_RES=YEARLY

#───────────────────────────────────────────────────────────────────────────────
# UI Configuration
#───────────────────────────────────────────────────────────────────────────────
UI_TITLE=Albedo
UI_FAVICON=magenta
DEFAULT_LANG=ru
AVAILABLE_LANGS='["en","ru"]'

# About text
ABOUT_EN="This interactive map helps you analyze vessel traffic and infrastructure pressure in Russia's Arctic waters along the Northern Sea Route between 2023 and 2025.\n\nIt visualizes how shipping activity has evolved over time, overlays the boundaries of protected areas, and allows you to identify when and where vessels crossed into these zones.\n\nUsing built-in filters, you can explore specific categories of vessels, track patterns of activity in key Arctic regions, and focus on areas where shipping, energy infrastructure, and environmental protection intersect.\n\nEach colored pixel represents the aggregated presence of vessels in that grid cell during the selected time period. Hover over an area at high zoom to see individual vessel details. Dates shown for protected area crossings indicate when a vessel was detected inside the protected zone."
ABOUT_RU="Эта интерактивная карта позволяет анализировать судоходный трафик и нагрузку на инфраструктуру в арктических водах России вдоль Северного морского пути в период с 2023 по 2025 год.\n\nОна визуализирует, как менялась судоходная активность с течением времени, показывает границы особо охраняемых природных территорий и позволяет определить, когда и где суда заходили в эти зоны.\n\nС помощью встроенных фильтров можно исследовать определённые категории судов, отслеживать закономерности активности в ключевых арктических регионах и сосредоточиться на районах пересечения судоходства, энергетической инфраструктуры и охраны окружающей среды.\n\nКаждый цветной пиксель представляет агрегированное присутствие судов в данной ячейке за выбранный период. Наведите курсор на область при большом увеличении, чтобы увидеть данные отдельных судов. Даты пересечений с охраняемыми территориями указывают, когда судно было обнаружено внутри охраняемой зоны."

#───────────────────────────────────────────────────────────────────────────────
# Places of Interest (JSON array)
#───────────────────────────────────────────────────────────────────────────────
PLACES_JSON='[{"id":"overview","name":{"en":"Overview","ru":"Обзор"},"description":{"en":"Full study area","ru":"Вся область исследования"},"center":[100,75],"zoom":2.5},{"id":"kara-sea","name":{"en":"Kara Sea","ru":"Карское море"},"description":{"en":"Gateway to the Northern Sea Route","ru":"Ворота Северного морского пути"},"center":[70,74],"zoom":5}]'
