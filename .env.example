# Albedo Configuration
# Copy to .env and edit values to generate a map for your region

#───────────────────────────────────────────────────────────────────────────────
# Data Hosting
#───────────────────────────────────────────────────────────────────────────────
# Base URL for data files (leave empty for local/relative paths)
COG_BASE_URL=
VITE_MANIFEST_URL=

#───────────────────────────────────────────────────────────────────────────────
# Data Source
#───────────────────────────────────────────────────────────────────────────────
# Get your API token from https://globalfishingwatch.org/
GFW_API_TOKEN=your_token_here
DATASET=public-global-presence:latest
SOURCE_URL=https://globalfishingwatch.org/
SOURCE_LABEL="Global Fishing Watch"
SOURCE_LABEL_SHORT=GFW

#───────────────────────────────────────────────────────────────────────────────
# Region Configuration
#───────────────────────────────────────────────────────────────────────────────
REGION_ID=my-region

# Bounding box (degrees)
SOUTH_LAT=-90
NORTH_LAT=90
WEST_LON=-180
EAST_LON=180

# Initial map view
CENTER_LON=0
CENTER_LAT=0
INITIAL_ZOOM=2
MIN_ZOOM=2

# Years to include (comma-separated, max 3 for RGB bands)
YEARS=2023,2024,2025

# Vessel types for per-type COGs (comma-separated)
VESSEL_TYPES=FISHING,CARGO,PASSENGER,CARRIER

# Flag filter presets (comma-separated, "foreign" = exclude HOME_FLAG)
FLAG_PRESETS=foreign,RUS,NOR,PAN,LBR,MHL,MLT,CHN,GBR
HOME_FLAG=RUS

# Resolution
SPATIAL_RES=HIGH
TEMPORAL_RES=YEARLY

#───────────────────────────────────────────────────────────────────────────────
# UI Configuration
#───────────────────────────────────────────────────────────────────────────────
UI_TITLE=Vessel Activity
UI_FAVICON=magenta
DEFAULT_LANG=ru
AVAILABLE_LANGS='["en"]'

# About text (add more languages as needed)
ABOUT_EN="Interactive map of vessel presence based on Global Fishing Watch data."

#───────────────────────────────────────────────────────────────────────────────
# Places of Interest (JSON array, optional)
#───────────────────────────────────────────────────────────────────────────────
PLACES_JSON='[{"id":"overview","name":{"en":"Overview"},"description":{"en":"Full study area"},"center":[0,0],"zoom":2}]'
