# Cloud Run deployment Makefile
# Deploy with: make -f Makefile.deploy deploy

PROJECT_NAME := arctic-shipping
GCP_PROJECT := data-desk-web
REGION := europe-west1
DOMAIN := tools.datadesk.eco

# Deploy to Cloud Run
deploy:
	@echo "🚀 Deploying $(PROJECT_NAME) to Cloud Run..."
	@gcloud run deploy $(PROJECT_NAME) \
		--source . \
		--region $(REGION) \
		--project $(GCP_PROJECT) \
		--allow-unauthenticated \
		--port 8080 \
		--max-instances 10 \
		--min-instances 0 \
		--memory 1Gi \
		--cpu 1 \
		--quiet
	@echo ""
	@echo "✅ Deployment complete!"
	@echo "🌐 Live at: $$(gcloud run services describe $(PROJECT_NAME) --region $(REGION) --project $(GCP_PROJECT) --format 'value(status.url)')"
	@echo "🔓 App is publicly accessible"
	@echo ""
	@echo "To map custom domain arctic-shipping.$(DOMAIN):"
	@echo "  Run: make -f Makefile.deploy domain"

# Quick update (just the app)
update:
	@gcloud run deploy $(PROJECT_NAME) \
		--source . \
		--region $(REGION) \
		--project $(GCP_PROJECT) \
		--allow-unauthenticated \
		--quiet
	@echo "✓ App updated"

# Get the app URL
url:
	@echo "Direct Cloud Run URL:"
	@gcloud run services describe $(PROJECT_NAME) \
		--region $(REGION) \
		--project $(GCP_PROJECT) \
		--format 'value(status.url)'
	@echo ""
	@echo "Custom domain: https://arctic-shipping.$(DOMAIN)"

# View logs
logs:
	@gcloud run logs read \
		--service $(PROJECT_NAME) \
		--region $(REGION) \
		--project $(GCP_PROJECT) \
		--limit 50

# Map custom domain
domain:
	@echo "Setting up domain mapping for arctic-shipping.$(DOMAIN)..."
	@gcloud run domain-mappings create \
		--service $(PROJECT_NAME) \
		--domain arctic-shipping.$(DOMAIN) \
		--region $(REGION) \
		--project $(GCP_PROJECT) || echo "Domain mapping may already exist"
	@echo "✅ Domain mapping configured"
	@echo "Add these DNS records:"
	@gcloud run domain-mappings describe arctic-shipping.$(DOMAIN) \
		--region $(REGION) \
		--project $(GCP_PROJECT) \
		--format="value(status.resourceRecords)"

# Remove everything
clean:
	@echo "Removing Cloud Run service..."
	@gcloud run services delete $(PROJECT_NAME) \
		--region $(REGION) \
		--project $(GCP_PROJECT) \
		--quiet 2>/dev/null || true
	@echo "✓ Cleanup complete"

help:
	@echo "Cloud Run Deployment Commands:"
	@echo "  make -f Makefile.deploy deploy  - Deploy app to Cloud Run"
	@echo "  make -f Makefile.deploy update  - Update just the app"
	@echo "  make -f Makefile.deploy domain  - Map custom domain"
	@echo "  make -f Makefile.deploy url     - Get the app URLs"
	@echo "  make -f Makefile.deploy logs    - View recent logs"
	@echo "  make -f Makefile.deploy clean   - Remove everything"

.PHONY: deploy update url logs domain clean help
